{
  "name": "jardinagem-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test:typecheck": "tsc --project tsconfig.test.json --noEmit",
    "test": "tsx --test tests/domain/*.test.ts",
    "test:auth": "tsx --env-file=.env.local --test tests/auth/*.test.ts",
    "test:clientes": "tsx --test tests/clientes/*.test.ts",
    "test:catalogo": "tsx --test tests/servicos/*.test.ts tests/produtos/*.test.ts tests/catalogo/*.test.ts",
    "test:orcamentos": "tsx --tsconfig tsconfig.test.json --test tests/orcamentos/*.test.ts",
    "test:areas": "tsx --tsconfig tsconfig.test.json --test tests/areas/*.test.ts",
    "test:pdf": "tsx --tsconfig tsconfig.test.json --test tests/application/orcamento-pdf-mapper.test.ts tests/application/gerar-pdf-orcamento.use-case.test.ts tests/infrastructure/expo-print-pdf-generator.test.ts tests/domain/consistencia-matematica-pdf.test.ts",
    "test:share": "tsx --tsconfig tsconfig.test.json --test tests/application/compartilhar-pdf-orcamento.use-case.test.ts tests/infrastructure/expo-sharing-provider.test.ts"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.116.0",
    "aes-js": "^3.1.2",
    "expo": "~57.0.23",
    "expo-constants": "~57.0.18",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-intent-launcher": "~57.0.1",
    "expo-linking": "~57.0.10",
    "expo-location": "~57.0.20",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.20",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-get-random-values": "~1.11.0",
    "react-native-maps": "^1.27.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@types/aes-js": "^3.1.4",
    "@types/node": "^22.20.3",
    "@types/react": "~19.2.2",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3"
  },
  "private": true
}
