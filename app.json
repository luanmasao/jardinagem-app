{
  "expo": {
    "name": "Sistema de Orçamentos para Jardinagem",
    "slug": "jardinagem-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "jardinagem-app",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.jardinagem.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#2e7d32"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permitir que o aplicativo acesse sua localização para posicionar o mapa no terreno de serviço.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
