@startuml

title Diagrama de Classes - Sistema de Orçamentos para Jardinagem
' Versão UML v3.1

skinparam classAttributeIconSize 0

class Usuario {
    - id : UUID
    - nome : String
    - telefone : String
    - dataCadastro : DateTime
    - ativo : Boolean

    + ativar() : void
    + desativar() : void
}

class Cliente {
    - id : UUID
    - nome : String
    - telefone : String
    - email : String
    - documento : String
    - observacoes : String
    - ativo : Boolean

    + atualizarDados() : void
    + ativar() : void
    + desativar() : void
}

class Endereco {
    - id : UUID
    - cep : String
    - logradouro : String
    - numero : String
    - complemento : String
    - bairro : String
    - cidade : String
    - estado : String
    - latitude : Decimal
    - longitude : Decimal

    + atualizar() : void
}

class Servico {
    - id : UUID
    - nome : String
    - descricao : String
    - unidade : String
    - precoBase : Decimal
    - usaMedicaoArea : Boolean
    - ativo : Boolean

    + atualizar() : void
    + ativar() : void
    + desativar() : void
}

class Produto {
    - id : UUID
    - nome : String
    - descricao : String
    - unidade : String
    - precoBase : Decimal
    - ativo : Boolean

    + atualizar() : void
    + ativar() : void
    + desativar() : void
}

class Orcamento {
    - id : UUID
    - numero : String
    - dataCriacao : DateTime
    - dataValidade : Date
    - status : StatusOrcamento
    - subtotal : Decimal
    - tipoDesconto : TipoDesconto
    - valorDesconto : Decimal
    - total : Decimal
    - observacoes : String
    - condicoesPagamento : String

    + calcularSubtotal() : Decimal
    + calcularDesconto() : Decimal
    + calcularTotal() : Decimal
    + duplicar() : Orcamento
    + validarEnvio() : Boolean
    + enviar() : void
    + alterarStatus() : void
}

class ItemOrcamento {
    - id : UUID
    - tipo : TipoItem
    - descricao : String
    - quantidade : Decimal
    - unidade : String
    - valorUnitario : Decimal
    - valorTotal : Decimal
    - usaMedicaoArea : Boolean

    + calcularTotal() : Decimal
    + atualizarQuantidade() : void
    + recalcularQuantidadePelasAreas() : Decimal
}

class Area {
    - id : UUID
    - nome : String
    - geometria : Polygon
    - areaCalculada : Decimal
    - unidade : String
    - observacoes : String

    + calcularArea() : Decimal
    + atualizarGeometria() : void
    + atualizarArea() : void
}

enum StatusOrcamento {
    RASCUNHO
    ENVIADO
    EM_ANALISE
    APROVADO
    RECUSADO
    EXPIRADO
    CANCELADO
    CONCLUIDO
}

enum TipoDesconto {
    PERCENTUAL
    FIXO
}

enum TipoItem {
    SERVICO
    PRODUTO
}

Usuario "1" -- "0..*" Cliente : possui >
Usuario "1" -- "0..*" Servico : cadastra >
Usuario "1" -- "0..*" Produto : cadastra >
Usuario "1" -- "0..*" Orcamento : cria >

Cliente "1" -- "0..1" Endereco : possui >
Cliente "1" -- "0..*" Orcamento : recebe >

Orcamento "1" *-- "0..*" ItemOrcamento : contém >

ItemOrcamento "0..1" --> "1" Servico : referencia >
ItemOrcamento "0..1" --> "1" Produto : referencia >

ItemOrcamento "1" *-- "0..*" Area : possui >

Orcamento --> StatusOrcamento
Orcamento --> TipoDesconto
ItemOrcamento --> TipoItem

note right of ItemOrcamento
    Cada item referencia exatamente
    um Serviço OU um Produto.

    SERVICO XOR PRODUTO

    usaMedicaoArea é um snapshot
    da característica do Serviço no
    momento em que o item foi criado.

    Se usaMedicaoArea = true:
    quantidade = soma das áreas.
end note

note right of Area
    Áreas somente podem existir
    para itens de Serviço com
    usaMedicaoArea = true.

    geometria = POLYGON

    areaCalculada representa a
    área da geometria em m².
end note

note bottom of Orcamento
    RASCUNHO pode ser salvo incompleto.
    Ao sair de RASCUNHO, o orçamento
    deve atender às validações de envio.

    Alterações em orçamento que já
    saiu de RASCUNHO ocorrem por
    duplicação.
end note

note bottom of Servico
    usaMedicaoArea representa o
    comportamento atual do serviço
    no catálogo.
end note

@enduml