@startuml

title DER - Sistema de Orçamentos para Jardinagem
' Versão DER v1.1 - corrigida

hide circle
skinparam linetype ortho

entity USUARIO {
    * id : UUID <<PK>>
    --
    nome : VARCHAR(150)
    telefone : VARCHAR(30)
    data_cadastro : TIMESTAMPTZ
    ativo : BOOLEAN
}

entity CLIENTE {
    * id : UUID <<PK>>
    --
    * usuario_id : UUID <<FK>>
    nome : VARCHAR(150)
    telefone : VARCHAR(30)
    email : VARCHAR(255)
    documento : VARCHAR(30)
    observacoes : TEXT
    ativo : BOOLEAN
}

entity ENDERECO {
    * id : UUID <<PK>>
    --
    * cliente_id : UUID <<FK, UNIQUE>>
    cep : VARCHAR(10)
    logradouro : VARCHAR(200)
    numero : VARCHAR(20)
    complemento : VARCHAR(100)
    bairro : VARCHAR(100)
    cidade : VARCHAR(100)
    estado : VARCHAR(2)
    latitude : NUMERIC(9,6)
    longitude : NUMERIC(9,6)
}

entity SERVICO {
    * id : UUID <<PK>>
    --
    * usuario_id : UUID <<FK>>
    nome : VARCHAR(150)
    descricao : TEXT
    unidade : VARCHAR(30)
    preco_base : NUMERIC(10,2)
    usa_medicao_area : BOOLEAN
    ativo : BOOLEAN
}

entity PRODUTO {
    * id : UUID <<PK>>
    --
    * usuario_id : UUID <<FK>>
    nome : VARCHAR(150)
    descricao : TEXT
    unidade : VARCHAR(30)
    preco_base : NUMERIC(10,2)
    ativo : BOOLEAN
}

entity ORCAMENTO {
    * id : UUID <<PK>>
    --
    * usuario_id : UUID <<FK>>
    * cliente_id : UUID <<FK>>
    numero : VARCHAR(30)
    data_criacao : TIMESTAMPTZ
    data_validade : DATE
    status : STATUS_ORCAMENTO
    subtotal : NUMERIC(12,2)
    tipo_desconto : TIPO_DESCONTO
    valor_desconto : NUMERIC(12,2)
    total : NUMERIC(12,2)
    observacoes : TEXT
    condicoes_pagamento : TEXT
}

entity ITEM_ORCAMENTO {
    * id : UUID <<PK>>
    --
    * orcamento_id : UUID <<FK>>
    servico_id : UUID <<FK, NULL>>
    produto_id : UUID <<FK, NULL>>
    tipo : TIPO_ITEM
    descricao : VARCHAR(255)
    quantidade : NUMERIC(12,2)
    unidade : VARCHAR(30)
    valor_unitario : NUMERIC(12,2)
    valor_total : NUMERIC(12,2)
    usa_medicao_area : BOOLEAN
}

entity AREA {
    * id : UUID <<PK>>
    --
    * item_orcamento_id : UUID <<FK>>
    nome : VARCHAR(150)
    geometria : GEOMETRY(POLYGON,4326)
    area_calculada : NUMERIC(12,2)
    unidade : VARCHAR(30)
    observacoes : TEXT
}

enum STATUS_ORCAMENTO {
    RASCUNHO
    ENVIADO
    EM_ANALISE
    APROVADO
    RECUSADO
    EXPIRADO
    CANCELADO
    CONCLUIDO
}

enum TIPO_DESCONTO {
    PERCENTUAL
    FIXO
}

enum TIPO_ITEM {
    SERVICO
    PRODUTO
}

USUARIO ||--o{ CLIENTE : possui
USUARIO ||--o{ SERVICO : cadastra
USUARIO ||--o{ PRODUTO : cadastra
USUARIO ||--o{ ORCAMENTO : cria

CLIENTE ||--o| ENDERECO : possui
CLIENTE ||--o{ ORCAMENTO : recebe

ORCAMENTO ||--o{ ITEM_ORCAMENTO : possui

SERVICO ||--o{ ITEM_ORCAMENTO : referencia
PRODUTO ||--o{ ITEM_ORCAMENTO : referencia

ITEM_ORCAMENTO ||--o{ AREA : possui

note right of ITEM_ORCAMENTO
    SERVICO XOR PRODUTO.

    Cada item deve referenciar
    exatamente um dos dois.

    servico_id:
    opcional individualmente.

    produto_id:
    opcional individualmente.

    usa_medicao_area é um snapshot
    da configuração do serviço no
    momento em que o item foi criado.

    Se usa_medicao_area = TRUE:
    quantidade = soma das áreas.
end note

note right of AREA
    AREA somente pode estar associada
    a ITEM_ORCAMENTO de SERVICO com
    usa_medicao_area = TRUE.

    geometria:
    POLYGON / EPSG:4326

    area_calculada:
    área da geometria em m².
end note

note bottom of ORCAMENTO
    data_validade pode ser NULL em
    RASCUNHO.

    Ao sair de RASCUNHO, o orçamento
    precisa possuir validade válida.

    RASCUNHO não expira.

    Alterações em orçamento que já
    saiu de RASCUNHO ocorrem por
    duplicação.
end note

note bottom of SERVICO
    usa_medicao_area representa a
    configuração atual do serviço
    no catálogo.
end note

@enduml